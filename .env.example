# 不用这个文件也能跑：不设 KB_ROOT 直接启动，浏览器打开 /setup 走配置向导，配置写进 data/config.json
# 这里的变量优先级高于 config.json，只在脚本化部署或要覆盖某一项时才需要。空值算没设

# ---------- 登录 ----------
# password：独立部署，只有口令登录（默认）
# sso：平台部署，只能用以虎 One 账号登录，且必须在白名单里（登录后在 /access 勾选）
# both：两个入口都开，口令登录不受白名单限制
AUTH_MODE=password
# password / both 必填：登录口令（至少 8 位），也可以直接填 argon2 hash。sso 时不生效
KB_PASSWORD=
# 高级用法，自动化部署时用。平时留空，在向导第三步或 /access 里勾选，保存后立即生效
# 填了就以这里为准：/access 变只读，config.json 里的名单不再生效，改动要重启
# 填 username 或用户 id，逗号分隔，精确匹配。没有 username 的人要填 id
KB_ALLOWED_USERS=

# ---------- 站点 ----------
# 对外地址，分享链接用它生成，必须是 https（secure cookie）。平台部署可留空，自动取 YH_APP_URL
KB_BASE_URL=https://kb.example.com
# 知识库目录和数据目录。docker compose 已固定为 /library 和 /data，直接跑 npm start 时才需要设
# KB_ROOT=~/notes
# KB_DATA_DIR=./data
# 分享页显示的「来自 XXX 的分享」
KB_OWNER_NAME=知识库主人
# 在默认规则上追加 deny 规则，逗号分隔；写 !规则 可移除一条默认规则
KB_DENY_GLOBS=
# 前面有几层反向代理。直接暴露公网时必须为 0，否则客户端可伪造 IP 绕过登录锁定
KB_TRUST_PROXY=1
# 目录打包下载的体积上限（MB）
KB_ZIP_MAX_MB=1024
# 超过这个体积（MB）的 PDF / Office 不在线渲染，只给下载链接
KB_PREVIEW_MAX_MB=200
# 每份 PDF 进搜索索引的页数上限，超出的页搜不到，后台索引报告里会写「已截断」
KB_PDF_MAX_PAGES=50
# Office 原版预览（要有 LibreOffice：完整版镜像，或本机 brew install --cask libreoffice）
# 转换缓存放在 数据目录/previews，超过上限（MB）时清掉最久没打开的
KB_PREVIEW_CACHE_MB=2048
# 单个文件转换超时（秒），超时退回文字预览
KB_CONVERT_TIMEOUT_S=120
# soffice 路径，留空自动在 PATH 里找
# KB_SOFFICE=/usr/bin/soffice
# 设为 1 关闭 cookie 的 Secure 标记，只用于没有 https 的局域网调试
# KB_COOKIE_INSECURE=1
TZ=Asia/Shanghai

# ---------- 以虎 One 平台 ----------
# 平台托管时由平台自动注入，不用手填；外部应用在平台「管理 → 应用 → 登记外部应用」获得凭证
# 同时有 ID 和 SECRET 时，AI 默认走平台模型（笔记内容会发给平台），与 AUTH_MODE 无关
YH_CLIENT_ID=
YH_CLIENT_SECRET=
# 平台访问地址，浏览器跳转授权页用
YH_WEB_URL=
# 平台接口地址，服务端换 token、调模型用
YH_API_URL=
# 本应用对外地址，回调地址 = YH_APP_URL + /sso/callback；留空时取 KB_BASE_URL
YH_APP_URL=
# 平台挂载路径，如 /apps/knowledge，平台注入；只在拼「退出平台登录」地址时兜底
# YH_BASE_PATH=

# ---------- AI ----------
# 留空时自动选择：有 YH_CLIENT_ID + YH_CLIENT_SECRET 用 platform → 有 AI_API_KEY 用 openai
# → 本机有 claude 命令行用 claude-cli → 都没有则关闭。也可强制填 platform | openai | claude-cli | off
AI_PROVIDER=
# platform 通道指定模型，留空用平台默认模型
AI_PLATFORM_MODEL=
# openai 通道（任何 OpenAI 兼容接口）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# claude-cli 通道指定模型，留空用 CLI 默认
AI_CLI_MODEL=
# 单篇发给模型的字数上限
AI_MAX_CHARS=40000

# ---------- docker compose ----------
# 容器运行用户，须能写 ./data
KB_UID=1000
KB_GID=1000
# 1 = 完整版镜像（带 LibreOffice），默认 0 精简版。改了要重新 docker compose build
KB_WITH_OFFICE=0
# 绑定地址和端口，默认只绑本机，由反向代理对外
# KB_BIND=127.0.0.1
# KB_PORT=3030

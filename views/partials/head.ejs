<%
  const shareMode = typeof ctx !== 'undefined' && ctx && ctx.mode === 'share';
  const signedIn = locals.session && !shareMode;
  const hasTree = typeof tree !== 'undefined' && tree;
%><!doctype html>
<html lang="zh-CN" data-base="<%= base %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title><%= pageTitle %> · <%= siteName %></title>
<script src="<%= base %>/assets/theme.js"></script>
<link rel="icon" type="image/svg+xml" href="<%= base %>/assets/icon.svg">
<link rel="stylesheet" href="<%= base %>/assets/yh-vi.css">
<link rel="stylesheet" href="<%= base %>/assets/app.css">
</head>
<body>
<a class="skip" href="#main">跳到正文</a>
<header class="topbar">
  <% if (hasTree) { %>
  <button class="icon-btn" id="drawer-open" type="button" aria-label="打开目录" aria-controls="drawer" aria-expanded="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <% } %>
  <% if (shareMode) { %>
  <a class="brand" href="<%= ctx.home %>"><%- include('brand-icon') %><%= siteName %></a>
  <% } else { %>
  <a class="brand" href="<%= base %><%= signedIn ? '/' : '/login' %>"><%- include('brand-icon') %><%= siteName %></a>
  <% } %>
  <% if (signedIn) { %>
  <span class="top-version">v<%= version %></span>
  <form class="topsearch" action="<%= base %>/search" method="get" role="search">
    <input type="search" name="q" placeholder="搜索标题和正文" aria-label="搜索" value="<%= typeof q === 'string' ? q : '' %>">
  </form>
  <a class="icon-btn" href="<%= base %>/admin" aria-label="管理后台" title="管理后台">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h9M19 8h1M4 16h1M11 16h9"/><circle cx="16" cy="8" r="2.5"/><circle cx="8" cy="16" r="2.5"/></svg>
  </a>
  <% } else { %><span class="spacer"></span><% } %>
  <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色模式" title="切换深色模式">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path class="filled" d="M12 4a8 8 0 0 1 0 16z"/></svg>
  </button>
</header>
<% if (shareMode) { %>
<div class="share-banner">来自 <strong><%= ownerName %></strong> 的分享 · 有效期至 <%= fmtTime(ctx.share.expires_at) %></div>
<% } %>
<div class="shell<%= hasTree ? ' has-tree' : '' %>">
  <% if (hasTree) { %>
  <div class="scrim" id="scrim" hidden></div>
  <aside class="drawer" id="drawer" aria-label="目录" data-tree-url="<%= ctx.treeUrl %>">
    <div class="drawer-head">
      <span>目录</span>
      <button class="icon-btn" id="drawer-close" type="button" aria-label="关闭目录">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="tree"><%- include('tree-level', { level: tree, ctx, depth: 0 }) %></nav>
  </aside>
  <% } %>
  <main class="main" id="main">

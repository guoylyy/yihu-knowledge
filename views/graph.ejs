<%- include('partials/head') %>
<section class="graph" id="graph">
  <div class="graph-bar" id="graph-bar">
    <div class="graph-bar-row">
      <h1>关系图</h1>
      <span class="graph-stats muted small" id="graph-stats" aria-live="polite"></span>
      <button class="btn" id="graph-back" type="button" hidden>返回全图</button>
      <button class="btn" id="graph-fold" type="button" aria-controls="graph-bar-body" aria-expanded="true">收起</button>
    </div>
    <% if (focusMissing) { %><p class="notice" id="graph-missing">没找到这篇笔记，已显示全图。</p><% } %>
    <div class="graph-bar-body" id="graph-bar-body">
      <label class="graph-check" id="graph-all-label"><input type="checkbox" id="graph-all"> 显示孤立笔记</label>
      <div class="graph-legend" id="graph-legend" role="group" aria-label="按目录显示或隐藏"></div>
    </div>
  </div>
  <div class="graph-stage" id="graph-stage">
    <canvas id="graph-canvas" role="img" aria-label="笔记之间的双链关系图"></canvas>
    <div class="graph-state card" id="graph-state" role="status" hidden></div>
    <button class="btn graph-fit" id="graph-fit" type="button">适配屏幕</button>
  </div>
  <section class="ai-sheet graph-sheet" id="graph-sheet" role="dialog" aria-labelledby="graph-sheet-title" hidden>
    <div class="ai-grip" id="graph-sheet-grip" aria-hidden="true"><span></span></div>
    <header class="ai-head">
      <h2 id="graph-sheet-title"></h2>
      <button class="icon-btn" id="graph-sheet-close" type="button" aria-label="关闭">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>
    <div class="graph-sheet-body">
      <dl class="graph-facts">
        <div><dt>目录</dt><dd id="graph-sheet-dir"></dd></div>
        <div><dt>被引用</dt><dd id="graph-sheet-refs"></dd></div>
        <div><dt>双链</dt><dd id="graph-sheet-links"></dd></div>
      </dl>
      <p class="alert" id="graph-sheet-sensitive" hidden>含敏感内容，AI 与分享已禁用</p>
      <div class="actions">
        <a class="btn primary" id="graph-sheet-open" href="<%= base %>/">打开笔记</a>
        <button class="btn" id="graph-sheet-focus" type="button">看 2 跳邻域</button>
      </div>
    </div>
  </section>
</section>
<script type="module" src="<%= base %>/assets/graph.js"></script>
<%- include('partials/foot') %>
